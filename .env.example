# EDITH · esempio di configurazione.
# Il modo più semplice: «python3 edith-setup» fa le domande, verifica tutto e scrive il .env per te.
# A mano: copia questo file in .env e cambia i valori. Il .env contiene segreti: non metterlo su Git (è già in .gitignore).

# --- Base -------------------------------------------------------------------------------------------
ASSISTANT_NAME=EDITH
OWNER_NAME=Mario
OWNER_NICKNAME=Mario                         # come ti chiama la voce (se vuoto: OWNER_NAME)
TZ=Europe/Rome

# Moduli: calendar, tasks, notes, memory, weather, news, finance, server. Senza la riga: tutti. «none»: solo la base.
EDITH_PLUGINS=calendar,tasks,notes,memory,weather,news,finance,server

# Frasi per passione: marvel, linux, homelab, calcio, sci, studio, maker. Senza la riga: tutte.
EDITH_QUOTE_PACKS=marvel,linux,homelab

# --- Telegram (obbligatorio) ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:il-token-che-ti-da-BotFather
TELEGRAM_CHAT_ID=123456789                   # il tuo ID: la configurazione guidata lo trova da sola
ADMIN_IDS=                                   # altri utenti ammessi (solo finanze), separati da virgola

# --- Gemini (obbligatorio) --------------------------------------------------------------------------
GEMINI_API_KEY=la-tua-chiave-di-google-ai-studio
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest    # se il principale è sovraccarico; «off» per nessuno
GEMINI_AUDIO_MODEL=                          # per la voce; se vuoto usa GEMINI_MODEL

# --- Pagina web (via Tailscale) ---------------------------------------------------------------------
WEB_ENABLED=1
WEB_HOST=127.0.0.1                           # resta in locale: la espone «tailscale serve» (vedi README)
WEB_PORT=8787
WEB_ALLOWED_LOGINS=tuonome@gmail.com         # account Tailscale ammessi, separati da virgola
WEB_PASSWORD=                                # facoltativa, in alternativa a Tailscale
WEB_SECRET=                                  # firma dei cookie: la configurazione guidata ne genera uno casuale

# --- Nextcloud (moduli calendar, tasks, notes, memory) ----------------------------------------------
CALDAV_URL=https://cloud.esempio.it/remote.php/dav
CALDAV_USER=mario
CALDAV_PASSWORD=una-password-per-app         # Nextcloud → Impostazioni → Sicurezza → Password per app
CALENDAR_CATEGORIES=Personale,Lavoro,Sport   # i calendari tra cui EDITH sceglie
TASKS_DEFAULT_LIST=Da fare                   # la lista dei promemoria
MEMORY_NOTE_TITLE=EDITH Memoria              # la nota in cui EDITH ricorda le cose su di te

# --- Meteo (modulo weather, Open-Meteo: gratis, senza chiave) ---------------------------------------
WEATHER_PLACE=Roma
WEATHER_LAT=41.9028
WEATHER_LON=12.4964

# --- Orari dei messaggi automatici su Telegram ------------------------------------------------------
MORNING_TIME=07:30                           # buongiorno
NEWS_TIME=12:00                              # notizie di metà giornata (modulo news)
NEWS_EVENING_TIME=19:00                      # sera: domani e novità

# --- Finanze (modulo finance) -----------------------------------------------------------------------
DB_PATH=data/financebot.db
CHARTS_ENABLED=1                             # grafici notturni in Nextcloud
CHARTS_TIME=23:55
CHARTS_FOLDER=Grafici EDITH

# --- Server (modulo server) -------------------------------------------------------------------------
MON_ENABLED=1                                # avvisi automatici (CPU, memoria, dischi, Nextcloud)
MON_INTERVAL=60
