def ask(prompt: str, default: str = "", secret: bool = False, required: bool = False) -> str:
    shown = ("  [già impostato: Invio per tenerlo]" if default else "") if secret else (f" [{default}]" if default else "")
    while True:
        try:
            v = getpass.getpass(f"{prompt}{shown}: ") if secret else input(f"{prompt}{shown}: ")
        except EOFError:
            v = ""
        v = v.strip() or default
        if v or not required:
            return v
        print("  Serve una risposta.")


def yes_no(prompt: str, default: bool = True) -> bool:
    while True:
        v = ask(f"{prompt} (s/n)", "s" if default else "n").lower()
        if v in ("s", "si", "sì", "y", "yes"):
            return True
        if v in ("n", "no"):
            return False


def choose_many(title: str, options: list, chosen: list) -> list:
    """options: [(chiave, descrizione)]. Risposta: numeri separati da virgola, «tutti» o «nessuno»."""
    print(f"\n{title}")
    for i, (k, label) in enumerate(options, 1):
        print(f"  {i}. [{'x' if k in chosen else ' '}] {label}")
    default = ",".join(str(i) for i, (k, _) in enumerate(options, 1) if k in chosen) or "nessuno"
    while True:
        v = ask("Quali? (numeri separati da virgola, «tutti» o «nessuno»)", default).lower()
        if v in ("tutti", "all", "*"):
            return [k for k, _ in options]
        if v in ("nessuno", "none", "0"):
            return []
        try:
            idx = [int(x) for x in v.replace(" ", "").split(",") if x]
            if all(1 <= i <= len(options) for i in idx):
                return [k for i, (k, _) in enumerate(options, 1) if i in idx]
        except ValueError:
            pass
        print("  Non ho capito: scrivi per esempio 1,3,4")


def choose_one(title: str, options: list, default: str) -> str:
    print(f"\n{title}")
    for i, o in enumerate(options, 1):
        print(f"  {i}. {o}")
    d = str(options.index(default) + 1) if default in options else "1"
    while True:
        v = ask("Quale?", d)
        if v.isdigit() and 1 <= int(v) <= len(options):
            return options[int(v) - 1]
        if v in options:
            return v


