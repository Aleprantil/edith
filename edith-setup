ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from services.plugins import CATALOG  # noqa: E402  (solo l'elenco dei moduli: nessuna dipendenza)

TIMEOUT = 12
NEXTCLOUD_MODULES = [n for n, p in CATALOG.items() if p.needs_nextcloud]


class CheckError(Exception):
    """Una verifica non è riuscita: il messaggio è già da mostrare."""


