def http_json(url: str, data: dict = None, headers: dict = None, method: str = None, opener=urllib.request.urlopen):
    body = json.dumps(data).encode() if data is not None else None
    h = {"Accept": "application/json", **({"Content-Type": "application/json"} if body else {}), **(headers or {})}
    req = urllib.request.Request(url, data=body, headers=h, method=method or ("POST" if body else "GET"))
    with opener(req, timeout=TIMEOUT) as r:
        return json.loads(r.read().decode("utf-8"))


def check_telegram(token: str, opener=urllib.request.urlopen) -> str:
    try:
        r = http_json(f"https://api.telegram.org/bot{token}/getMe", opener=opener)
    except urllib.error.HTTPError as e:
        raise CheckError("Telegram rifiuta il token: ricontrollalo (lo dà @BotFather)." if e.code in (401, 404) else f"Telegram: errore {e.code}.") from e
    except (urllib.error.URLError, OSError) as e:
        raise CheckError("Telegram non risponde: c'è internet?") from e
    if not r.get("ok"):
        raise CheckError("Telegram rifiuta il token.")
    return "@" + r["result"].get("username", "?")


def find_chat_id(token: str, opener=urllib.request.urlopen):
    """L'ID della chat privata più recente che ha scritto al bot (serve /start al bot, prima)."""
    r = http_json(f"https://api.telegram.org/bot{token}/getUpdates", opener=opener)
    for u in reversed(r.get("result", [])):
        msg = u.get("message") or u.get("edited_message") or {}
        chat = msg.get("chat") or {}
        if chat.get("type") == "private" and chat.get("id"):
            who = chat.get("first_name") or chat.get("username") or ""
            return str(chat["id"]), who
    return None, None


def check_gemini(key: str, model: str, opener=urllib.request.urlopen) -> str:
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{urllib.parse.quote(model)}:generateContent"
    try:
        http_json(url, {"contents": [{"parts": [{"text": "Rispondi solo: ok"}]}]}, {"x-goog-api-key": key}, opener=opener)
    except urllib.error.HTTPError as e:
        if e.code in (400, 401, 403):
            raise CheckError("Gemini rifiuta la chiave: ricontrollala (si crea su Google AI Studio).") from e
        if e.code == 404:
            raise CheckError(f"Il modello «{model}» non esiste (più): scegline un altro.") from e
        if e.code in (429, 503):
            return "la chiave è valida, ma ora il modello è occupato (riprova più tardi)"
        raise CheckError(f"Gemini: errore {e.code}.") from e
    except (urllib.error.URLError, OSError) as e:
        raise CheckError("Gemini non risponde: c'è internet?") from e
    return "risponde"


def geocode(city: str, opener=urllib.request.urlopen):
    q = urllib.parse.urlencode({"name": city, "count": 1, "language": "it", "format": "json"})
    try:
        r = http_json(f"https://geocoding-api.open-meteo.com/v1/search?{q}", opener=opener)
    except (urllib.error.URLError, OSError) as e:
        raise CheckError("Il servizio del meteo non risponde: c'è internet?") from e
    res = (r.get("results") or [None])[0]
    if not res:
        raise CheckError(f"Non trovo «{city}»: prova con il nome del comune.")
    return res["name"], round(float(res["latitude"]), 4), round(float(res["longitude"]), 4), res.get("country", "")


def dav_url(base: str) -> str:
    """Accetta sia «https://cloud.esempio.it» sia l'indirizzo DAV completo."""
    base = base.strip().rstrip("/")
    if not base.startswith(("http://", "https://")):
        base = "https://" + base
    return base if base.endswith("/remote.php/dav") else base + "/remote.php/dav"


PROPFIND = b'''<?xml version="1.0"?>
<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">
  <d:prop><d:displayname/><d:resourcetype/><c:supported-calendar-component-set/></d:prop>
</d:propfind>'''
NS = {"d": "DAV:", "c": "urn:ietf:params:xml:ns:caldav"}


def parse_calendars(xml: bytes) -> list:
    """[(nome, accetta_eventi, accetta_promemoria)] dalla risposta PROPFIND di Nextcloud."""
    out = []
    for resp in ET.fromstring(xml).findall("d:response", NS):
        prop = resp.find("d:propstat/d:prop", NS)
        if prop is None or prop.find("d:resourcetype/c:calendar", NS) is None:
            continue
        name = (prop.findtext("d:displayname", default="", namespaces=NS) or "").strip()
        comps = {c.get("name") for c in prop.findall("c:supported-calendar-component-set/c:comp", NS)}
        if name:
            out.append((name, "VEVENT" in comps or not comps, "VTODO" in comps))
    return out


def check_nextcloud(url: str, user: str, password: str, opener=urllib.request.urlopen) -> list:
    target = f"{url}/calendars/{urllib.parse.quote(user)}/"
    auth = base64.b64encode(f"{user}:{password}".encode()).decode()
    req = urllib.request.Request(target, data=PROPFIND, method="PROPFIND",
                                 headers={"Authorization": f"Basic {auth}", "Depth": "1", "Content-Type": "application/xml"})
    try:
        with opener(req, timeout=TIMEOUT) as r:
            return parse_calendars(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise CheckError("Nextcloud rifiuta utente o password. Usa una «password per app» (Impostazioni → Sicurezza).") from e
        raise CheckError(f"Nextcloud risponde con l'errore {e.code}: l'indirizzo è giusto?") from e
    except (urllib.error.URLError, OSError) as e:
        raise CheckError("Nextcloud non risponde: indirizzo sbagliato, o il server è spento?") from e
    except ET.ParseError as e:
        raise CheckError("Nextcloud ha risposto in un modo che non capisco: l'indirizzo è giusto?") from e


def verify(label: str, fn, *args):
    """Esegue una verifica e la racconta. Restituisce (ok, risultato)."""
    try:
        res = fn(*args)
        print(f"  ✓ {label}: {res if isinstance(res, str) else 'ok'}")
        return True, res
    except CheckError as e:
        print(f"  ✗ {label}: {e}")
        return False, None


