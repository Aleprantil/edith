# Il file .env
# ---------------------------------------------------------------------------

def read_env(path: Path) -> dict:
    out = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        else:
            v = "" if v.startswith("#") else re.split(r"\s+#", v, maxsplit=1)[0].strip()   # commento in fondo alla riga (come fa Docker)
        out[k.strip()] = v
    return out


SECTIONS = [
    ("Base", ["ASSISTANT_NAME", "OWNER_NAME", "OWNER_NICKNAME", "EDITH_PLUGINS", "EDITH_QUOTE_PACKS"]),
    ("Telegram", ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "ADMIN_IDS"]),
    ("Gemini", ["GEMINI_API_KEY", "GEMINI_MODEL", "GEMINI_FALLBACK_MODEL"]),
    ("Pagina web (via Tailscale)", ["WEB_ENABLED", "WEB_ALLOWED_LOGINS", "WEB_PASSWORD", "WEB_SECRET"]),
    ("Nextcloud (calendario, promemoria, note, memoria)", ["CALDAV_URL", "CALDAV_USER", "CALDAV_PASSWORD", "CALENDAR_CATEGORIES", "TASKS_DEFAULT_LIST"]),
    ("Meteo", ["WEATHER_PLACE", "WEATHER_LAT", "WEATHER_LON"]),
]


def env_line(k: str, v: str) -> str:
    v = str(v)
    if v != v.strip() or "#" in v or '"' in v:
        v = '"' + v.replace('"', '\\"') + '"'
    return f"{k}={v}"


def write_env(path: Path, values: dict) -> Path:
    """Scrive il .env (permessi 600). Se c'era già, ne tiene una copia accanto. Le voci che non conosco restano in fondo."""
    backup = None
    if path.exists():
        backup = path.with_name(path.name + time.strftime(".bak-%Y%m%d-%H%M%S"))
        backup.write_bytes(path.read_bytes())
        os.chmod(backup, 0o600)
    lines, done = ["# EDITH · scritto dalla configurazione guidata (python3 edith-setup). Contiene segreti: non condividerlo.", ""], set()
    for title, keys in SECTIONS:
        block = [env_line(k, values[k]) for k in keys if values.get(k) not in (None, "")]
        if block:
            lines += [f"# --- {title}"] + block + [""]
            done.update(keys)
    rest = [env_line(k, v) for k, v in values.items() if k not in done and v not in (None, "")]
    if rest:
        lines += ["# --- Altre impostazioni (rimaste com'erano)"] + rest + [""]
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    os.chmod(path, 0o600)
    return backup


