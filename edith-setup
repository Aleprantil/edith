def quote_packs() -> dict:
    try:
        return json.loads((ROOT / "web" / "static" / "frasi.json").read_text(encoding="utf-8")).get("pacchetti", {})
    except (OSError, ValueError):
        return {}


def run(path: Path) -> dict:
    v = read_env(path)
    print("EDITH · configurazione guidata\n"
          "Premi Invio per tenere il valore tra parentesi. I segreti non vengono mostrati mentre li scrivi.\n")

    print("── 1. Tu e il tuo assistente")
    v["ASSISTANT_NAME"] = ask("Come si chiama l'assistente", v.get("ASSISTANT_NAME", "EDITH"))
    v["OWNER_NAME"] = ask("Il tuo nome", v.get("OWNER_NAME", ""), required=True)
    v["OWNER_NICKNAME"] = ask("Come vuoi che ti chiami (Invio = il nome)", v.get("OWNER_NICKNAME", ""))

    print("\n── 2. Telegram")
    print("  Crea un bot con @BotFather su Telegram e incolla qui il suo token.")
    while True:
        v["TELEGRAM_BOT_TOKEN"] = ask("Token del bot", v.get("TELEGRAM_BOT_TOKEN", ""), secret=True, required=True)
        ok, _ = verify("Bot", check_telegram, v["TELEGRAM_BOT_TOKEN"])
        if ok or not yes_no("Riprovo con un altro token?", True):
            break
    if not v.get("TELEGRAM_CHAT_ID") or yes_no("Vuoi rilevare di nuovo il tuo ID Telegram?", False):
        input("  Scrivi /start al tuo bot su Telegram, poi premi Invio qui… ")
        try:
            chat, who = find_chat_id(v["TELEGRAM_BOT_TOKEN"])
        except (urllib.error.URLError, OSError, ValueError):
            chat, who = None, None
        if chat:
            print(f"  ✓ Trovato: {chat}" + (f" ({who})" if who else ""))
        v["TELEGRAM_CHAT_ID"] = ask("Il tuo ID Telegram", chat or v.get("TELEGRAM_CHAT_ID", ""), required=True)

    print("\n── 3. Gemini (l'intelligenza che capisce le richieste)")
    print("  La chiave si crea gratis su Google AI Studio.")
    v["GEMINI_MODEL"] = v.get("GEMINI_MODEL") or "gemini-2.5-flash"
    while True:
        v["GEMINI_API_KEY"] = ask("Chiave di Gemini", v.get("GEMINI_API_KEY", ""), secret=True, required=True)
        v["GEMINI_MODEL"] = ask("Modello", v["GEMINI_MODEL"])
        ok, _ = verify("Gemini", check_gemini, v["GEMINI_API_KEY"], v["GEMINI_MODEL"])
        if ok or not yes_no("Riprovo?", True):
            break
    v["GEMINI_FALLBACK_MODEL"] = ask("Modello di riserva, se il principale è sovraccarico («off» per nessuno)",
                                     v.get("GEMINI_FALLBACK_MODEL", "gemini-flash-latest"))

    print("\n── 4. Pagina web")
    v["WEB_ENABLED"] = "1" if yes_no("Vuoi la pagina web (dal telefono e dal PC, via Tailscale)?", v.get("WEB_ENABLED", "1") != "0") else "0"
    if v["WEB_ENABLED"] == "1":
        print("  Entra chi è collegato a Tailscale con uno di questi account (es. tuonome@gmail.com, separati da virgola).")
        v["WEB_ALLOWED_LOGINS"] = ask("Account Tailscale ammessi", v.get("WEB_ALLOWED_LOGINS", ""), required=True)
        v["WEB_SECRET"] = v.get("WEB_SECRET") or secrets.token_hex(32)

    print("\n── 5. Moduli")
    current = [x.strip() for x in v.get("EDITH_PLUGINS", "").split(",") if x.strip()] or list(CATALOG)
    chosen = choose_many("Quali moduli vuoi? (la base, con chat, voce e pagina, c'è sempre)",
                         [(n, f"{p.title} – {p.description}") for n, p in CATALOG.items()], current)
    v["EDITH_PLUGINS"] = ",".join(chosen) if chosen else "none"

    if any(n in chosen for n in NEXTCLOUD_MODULES):
        print("\n── 6. Nextcloud")
        while True:
            v["CALDAV_URL"] = dav_url(ask("Indirizzo di Nextcloud (es. https://cloud.esempio.it)", v.get("CALDAV_URL", ""), required=True))
            v["CALDAV_USER"] = ask("Utente", v.get("CALDAV_USER", ""), required=True)
            v["CALDAV_PASSWORD"] = ask("Password per app (Impostazioni → Sicurezza)", v.get("CALDAV_PASSWORD", ""), secret=True, required=True)
            ok, cals = verify("Nextcloud", check_nextcloud, v["CALDAV_URL"], v["CALDAV_USER"], v["CALDAV_PASSWORD"])
            if ok:
                events = [n for n, ev, _ in cals if ev]
                lists = [n for n, _, td in cals if td]
                print(f"  Calendari trovati: {', '.join(events) or 'nessuno'}")
                if "calendar" in chosen:
                    v["CALENDAR_CATEGORIES"] = ask("Calendari tra cui EDITH sceglie (separati da virgola)",
                                                   v.get("CALENDAR_CATEGORIES") or ",".join(events))
                if "tasks" in chosen and lists:
                    v["TASKS_DEFAULT_LIST"] = choose_one("Quale lista usare per i promemoria?", lists, v.get("TASKS_DEFAULT_LIST", lists[0]))
                apps = [a for m, a in (("tasks", "Tasks"), ("news", "News")) if m in chosen]
                if apps:
                    print(f"  Ricorda: in Nextcloud servono le app {', '.join(apps)} (Applicazioni → cerca il nome → Abilita).")
                if "notes" in chosen or "memory" in chosen:
                    print("  Note e memoria sono file normali in Nextcloud: l'app Notes non è obbligatoria, ma comoda per leggerle.")
                if "news" in chosen:
                    print("  Le notizie arrivano dai feed che aggiungi nell'app News (meglio se divisi in cartelle: Sport, Tech, Mondo…).")
                break
            if not yes_no("Riprovo?", True):
                break

    if "finance" in chosen and not v.get("CALDAV_URL"):
        v["CHARTS_ENABLED"] = "0"                                # senza Nextcloud i grafici notturni non hanno dove andare
    if "weather" in chosen:
        print("\n── 7. Meteo")
        while True:
            city = ask("La tua città", v.get("WEATHER_PLACE", ""), required=True)
            ok, res = verify("Città", geocode, city)
            if ok:
                name, lat, lon, country = res
                print(f"  ✓ {name}{', ' + country if country else ''}: {lat}, {lon}")
                v["WEATHER_PLACE"], v["WEATHER_LAT"], v["WEATHER_LON"] = name, str(lat), str(lon)
                break
            if not yes_no("Riprovo?", True):
                break

    packs = quote_packs()
    if packs:
        current = [x.strip() for x in v.get("EDITH_QUOTE_PACKS", "").split(",") if x.strip()] or list(packs)
        chosen_packs = choose_many("── 8. Le tue passioni (EDITH sceglie le frasi del giorno di conseguenza)", list(packs.items()), current)
        v["EDITH_QUOTE_PACKS"] = "" if set(chosen_packs) == set(packs) else ",".join(chosen_packs or ["nessuno"])
    return v


def check_only(path: Path) -> int:
    v = read_env(path)
    if not v:
        print(f"Non trovo {path}: lancia prima «python3 edith-setup».")
        return 1
    results = []
    if v.get("TELEGRAM_BOT_TOKEN"):
        results.append(verify("Telegram", check_telegram, v["TELEGRAM_BOT_TOKEN"])[0])
    if v.get("GEMINI_API_KEY"):
        results.append(verify("Gemini", check_gemini, v["GEMINI_API_KEY"], v.get("GEMINI_MODEL", "gemini-2.5-flash"))[0])
    if v.get("CALDAV_URL"):
        results.append(verify("Nextcloud", check_nextcloud, v["CALDAV_URL"], v.get("CALDAV_USER", ""), v.get("CALDAV_PASSWORD", ""))[0])
    if v.get("WEATHER_PLACE"):
        results.append(verify("Meteo", geocode, v["WEATHER_PLACE"])[0])
    print("Tutto a posto." if all(results) else "Qualcosa non va: rilancia «python3 edith-setup» per correggere.")
    return 0 if all(results) else 1


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Configurazione guidata di EDITH")
    ap.add_argument("--file", default=str(ROOT / ".env"), help="il file da scrivere (di serie: .env nella cartella di EDITH)")
    ap.add_argument("--check", action="store_true", help="controlla il .env che c'è già, senza cambiarlo")
    a = ap.parse_args(argv)
    path = Path(a.file)
    if a.check:
        return check_only(path)
    try:
        values = run(path)
    except KeyboardInterrupt:
        print("\nInterrotto: non ho scritto niente.")
        return 1
    backup = write_env(path, values)
    print(f"\n✓ Scritto {path} (leggibile solo da te)." + (f" La versione di prima è in {backup.name}." if backup else ""))
    print("Ora avvia EDITH:   docker compose up -d --build")
    return 0


if __name__ == "__main__":
    sys.exit(main())
